[Unit]
Description=@DOMAIN@ — Celery worker
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
User=nur
Group=nur
WorkingDirectory=@REPO_DIR@/edu_platform/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=@REPO_DIR@/venv/bin/celery -A config worker -l info --concurrency @WORKERS@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
